{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "heroui-react": {
            "command": "npx",
            "args": [
                "-y",
                "@heroui/react-mcp@latest"
            ]
        }
    }
}
