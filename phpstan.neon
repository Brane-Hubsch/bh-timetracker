includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 9

    ignoreErrors:
        # Used by tests only until the first tenant model (Client) arrives in phase 2. Remove then.
        -
            identifier: trait.unused
            path: app/Models/Concerns/BelongsToOrganization.php
