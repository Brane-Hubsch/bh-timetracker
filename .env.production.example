# Production settings for BH Timetracker. Copy to .env next to compose.yaml on the server and fill in
# the blanks. compose.yaml passes it to every container (and sets APP_ENV, DB_CONNECTION and DB_HOST
# itself). Never commit real secrets.

APP_NAME="BH Timetracker"
APP_ENV=production
APP_KEY=                      # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://tid.example.se # public HTTPS URL; also the host FrankenPHP gets a certificate for

APP_LOCALE=sv
APP_FALLBACK_LOCALE=en

# Empty with the Docker setup: FrankenPHP terminates TLS and passes the real client IP to Laravel
# (behind Cloudflare too, see TRUSTED_PROXY below). Set proxy IPs/CIDRs only if another proxy is
# added in front of the container.
TRUSTED_PROXIES=

# Logs go to the containers' output: docker compose logs -f
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Also used to create the postgres service's database and user on the first start.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=bh_timetracker
DB_USERNAME=bh_timetracker
DB_PASSWORD=                  # long random string
DB_SSLMODE=prefer             # the database is only reachable inside the compose network

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database     # processed by the queue service
CACHE_STORE=database

MAIL_MAILER=smtp              # or postmark/resend/ses
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="tid@example.se"
MAIL_FROM_NAME="${APP_NAME}"

# Passwordless only in production; password login is ignored here anyway.
AUTH_PASSWORD_LOGIN=false
AUTH_OPEN_REGISTRATION=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth keys for MCP clients. Either paste them here (php artisan passport:keys, then the files'
# contents), or generate them once in the storage volume: docker compose exec web php artisan passport:keys
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

# Nightly backups (config/backup.php) to a private bucket of their own. Cloudflare R2: region "auto"
# and endpoint https://<account id>.r2.cloudflarestorage.com, with an API token limited to the bucket
# (Object Read & Write). AWS S3: region e.g. eu-north-1 and no endpoint.
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_DEFAULT_REGION=auto
BACKUP_AWS_BUCKET=
BACKUP_AWS_ENDPOINT=
BACKUP_ARCHIVE_PASSWORD=      # long random string; store it outside the server too
BACKUP_NOTIFICATION_EMAIL=    # receives mail when a backup fails or looks wrong
DB_DUMP_BINARY_PATH=          # not needed in the Docker image (pg_dump 17 matches postgres:17)

# Docker: TRUSTED_PROXY tells Caddy whose X-Forwarded-For/CF-Connecting-IP to trust: cloudflare
# (default; Cloudflare and private networks), local (private networks only) or off.
# TRUSTED_PROXY=cloudflare
# Set to off to serve a self-signed certificate instead of Let's Encrypt (e.g. a test server).
# CADDY_AUTO_HTTPS=on

# Baked into the frontend at build time (docker compose build).
VITE_APP_NAME="${APP_NAME}"
