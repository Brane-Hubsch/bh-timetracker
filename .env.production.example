# Production settings for BH Timetracker on a server of your own (compose.yaml + compose.standalone.yaml).
# Copy to .env next to compose.yaml and fill in the blanks. In Coolify, set the same variables under the
# application's Environment Variables instead; Coolify lists them from compose.yaml.
# Only the settings listed in compose.yaml (x-app-environment) reach the containers: add a new one
# there too. compose.yaml sets APP_ENV, DB_CONNECTION, DB_HOST and DB_PORT itself. Never commit real
# secrets.

# Runs compose.yaml with the standalone additions (TLS and ports 80/443) on plain `docker compose`.
COMPOSE_FILE=compose.yaml:compose.standalone.yaml

APP_NAME="BH Timetracker"
APP_ENV=production
APP_KEY=                      # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://tid.example.se # public HTTPS URL; standalone: also the host FrankenPHP gets a certificate for

APP_LOCALE=sv
APP_FALLBACK_LOCALE=en

# Proxies whose X-Forwarded-For Laravel trusts for the visitor's IP (rate limits). On your own server
# visitors connect directly, so leave it empty (compose.standalone.yaml's default). Coolify's default
# trusts its proxy on private networks. Behind Cloudflare, add Cloudflare's ranges
# (https://www.cloudflare.com/ips/), comma separated; otherwise Laravel sees Cloudflare's address.
TRUSTED_PROXIES=

# Logs go to the containers' output: docker compose logs -f
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Also used to create the postgres service's database and user on the first start.
DB_DATABASE=bh_timetracker
DB_USERNAME=bh_timetracker
DB_PASSWORD=                  # long random string
DB_SSLMODE=prefer             # the database is only reachable inside the compose network

SESSION_DRIVER=database
SESSION_LIFETIME=20160
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database     # processed by the queue service
CACHE_STORE=database

MAIL_MAILER=smtp              # or postmark/resend/ses
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="tid@example.se"
MAIL_FROM_NAME="${APP_NAME}"
# POSTMARK_API_KEY= / RESEND_API_KEY= with MAIL_MAILER=postmark / resend

# Passwordless only in production (compose.yaml turns password login off).
AUTH_OPEN_REGISTRATION=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth keys for MCP clients. Either paste them here (php artisan passport:keys, then the files'
# contents), or generate them once in the storage volume: docker compose exec web php artisan passport:keys
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

# Nightly backups (config/backup.php) to a private bucket of their own. Cloudflare R2: region "auto"
# and endpoint https://<account id>.r2.cloudflarestorage.com, with an API token limited to the bucket
# (Object Read & Write). AWS S3: region e.g. eu-north-1 and no endpoint.
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_DEFAULT_REGION=auto
BACKUP_AWS_BUCKET=
BACKUP_AWS_ENDPOINT=
BACKUP_ARCHIVE_PASSWORD=      # long random string; store it outside the server too
BACKUP_NOTIFICATION_EMAIL=    # receives mail when a backup fails or looks wrong

# Octane (worker mode) in the web container: number of workers (auto = per CPU), requests before a
# worker is replaced, and the time limit per request in seconds.
# OCTANE_WORKERS=auto
# OCTANE_MAX_REQUESTS=500
# OCTANE_MAX_EXECUTION_TIME=120

# Standalone only: off serves a self-signed certificate instead of Let's Encrypt (e.g. a test server).
# CADDY_AUTO_HTTPS=on
