# Production settings for BH Timetracker. Copy to the server's .env (or the hosting platform's
# environment) and fill in the blanks. Never commit real secrets.

APP_NAME="BH Timetracker"
APP_ENV=production
APP_KEY=                      # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://tid.example.se # public HTTPS URL; used in emails, passkeys and OAuth metadata

APP_LOCALE=sv
APP_FALLBACK_LOCALE=en

# Comma separated proxy IPs/CIDRs, or * when the app is only reachable through the load balancer.
TRUSTED_PROXIES=*

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=bh_timetracker
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database     # run a worker: php artisan queue:work --tries=3
CACHE_STORE=database

MAIL_MAILER=smtp              # or postmark/resend/ses
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="tid@example.se"
MAIL_FROM_NAME="${APP_NAME}"

# Passwordless only in production; password login is ignored here anyway.
AUTH_PASSWORD_LOGIN=false
AUTH_OPEN_REGISTRATION=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth keys for MCP clients (php artisan passport:keys, then paste the files' contents), unless the
# keys are generated on the server in storage/.
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

# Nightly backups (config/backup.php) to a private bucket of their own. Cloudflare R2: region "auto"
# and endpoint https://<account id>.r2.cloudflarestorage.com, with an API token limited to the bucket
# (Object Read & Write). AWS S3: region e.g. eu-north-1 and no endpoint.
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_DEFAULT_REGION=auto
BACKUP_AWS_BUCKET=
BACKUP_AWS_ENDPOINT=
BACKUP_ARCHIVE_PASSWORD=      # long random string; store it outside the server too
BACKUP_NOTIFICATION_EMAIL=    # receives mail when a backup fails or looks wrong
DB_DUMP_BINARY_PATH=          # only when pg_dump for the server's version isn't on the PATH

VITE_APP_NAME="${APP_NAME}"
